def insert_sorted(sorted_list, value):
    for i in range(len(sorted_list)):
        if value <= sorted_list[i]:
            sorted_list.insert(i, value)
            return
    sorted_list.append(value)

sorted_list = []

print("Enter integers one by one. Press Enter to stop.\n")

while True:
    user_input = input("Enter an integer: ")
    if user_input == "":
        break
    try:
        number = int(user_input)
        insert_sorted(sorted_list, number)
        print(f"  List so far: {sorted_list}")
    except ValueError:
        print("  Invalid input. Please enter a valid integer.")

print("\nFinal Sorted List:", sorted_list)

