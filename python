def remove_duplicates(list):
    seen = set()
    result = []
    for i in list:
        if i not in seen:
            seen.add(i)
            result.append(i)
    return result

num = [1,2,2,5,7,3,2,1]

print("Without duplicates:", remove_duplicates(num))



